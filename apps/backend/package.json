{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.ts\""
  },
  "dependencies": {
    "@darkling/guide": "workspace:*",
    "@darkling/knowledge-base": "workspace:*",
    "@darkling/service-bus": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  }
}