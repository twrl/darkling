{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.ts\""
  },
  "dependencies": {
    "@darkling/guide": "workspace:*",
    "@darkling/knowledge-base": "workspace:*",
    "@darkling/service-bus": "workspace:*",
    "@darkling/state-manager": "workspace:*",
    "immer": "^10.1.7",
    "lit": "^3.3.3",
    "signal-polyfill": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lit-labs/signals": "^0.3.0",
    "@lit/context": "^1.1.6",
    "@repo/eslint-config": "workspace:*",
    "typescript": "^5.4.0",
    "vite": "^8.2.1",
    "vitest": "^3.2.7"
  }
}
